[
  {
    "name": "single provider auto-pins despite the tier default naming another backend",
    "config": {
      "tierDefaults": {
        "sm": "codex",
        "md": "codex",
        "lg": "codex",
        "big": "codex"
      },
      "tiers": [
        "sm",
        "md",
        "lg",
        "big"
      ],
      "backends": {
        "claude": {
          "big": {
            "model": "opus"
          }
        },
        "codex": {
          "sm": {
            "model": "gpt-5.4-mini",
            "options": {
              "reasoningEffort": "low"
            }
          }
        }
      }
    },
    "tier": "big",
    "expected": {
      "backend": "claude",
      "model": "opus"
    }
  },
